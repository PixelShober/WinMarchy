    { "keys": "Win+Up", "do": "wm:focus --direction up", "group": "tiling", "label": { "de": "Fokus nach oben", "en": "Focus up" } },
    { "keys": "Win+Down", "do": "wm:focus --direction down", "group": "tiling", "label": { "de": "Fokus nach unten", "en": "Focus down" } },
