{
  "title": { "de": "Business", "en": "Business" },
  "bindings": [
    { "keys": "Win+W", "do": "wm:close", "group": "tiling", "label": { "de": "Fenster schließen", "en": "Close window" } },
    { "keys": "Win+Q", "do": "wm:close", "group": "tiling", "optional": true, "label": { "de": "Fenster schließen", "en": "Close window" } },
    { "keys": "Win+J", "do": "do:toggle-split", "group": "tiling", "label": { "de": "Teilung drehen", "en": "Toggle split" }, "note": { "de": "Nebeneinander wird übereinander und zurück, sofort.", "en": "Side by side becomes stacked and back, right away." } },
    { "keys": "Win+Alt+J", "do": "wm:toggle-tiling-direction", "group": "tiling", "optional": true, "label": { "de": "Teilung für das nächste Fenster", "en": "Split direction for the next window" } },
    { "keys": "Win+T", "do": "wm:toggle-floating --centered", "group": "tiling", "label": { "de": "Schwebend oder gekachelt", "en": "Toggle floating" }, "note": { "de": "Das Fenster verlässt die Kacheln; andere Fenster können es überdecken.", "en": "The window leaves the tiles; other windows can cover it." } },
    { "keys": "Win+O", "do": "wm:toggle-floating --centered --shown-on-top", "group": "tiling", "label": { "de": "Herauslösen und oben halten", "en": "Pop out and keep on top" }, "note": { "de": "Schwebt und bleibt über allen anderen Fenstern.", "en": "Floats and stays above every other window." } },
    { "keys": "Win+F", "do": "wm:toggle-fullscreen", "group": "tiling", "label": { "de": "Vollbild", "en": "Full screen" } },
    { "keys": "Win+Alt+F", "do": "wm:toggle-fullscreen --maximized", "group": "tiling", "label": { "de": "Volle Breite", "en": "Full width" } },
    { "keys": "Win+Ctrl+J", "do": "do:layout-next", "group": "tiling", "omarchy": "SUPER + L", "label": { "de": "Layout wechseln: Dwindle, Spalten, Scrolling", "en": "Cycle layout: dwindle, columns, scrolling" }, "note": { "de": "Win+L gehört unter Windows dem Sperren, und auch Win+Alt+L kommt nicht immer an.", "en": "Win+L belongs to locking on Windows, and Win+Alt+L does not always come through either." } },

    { "keys": "Win+Left", "do": "do:focus left", "group": "tiling", "label": { "de": "Fokus nach links", "en": "Focus left" } },
    { "keys": "Win+Right", "do": "do:focus right", "group": "tiling", "label": { "de": "Fokus nach rechts", "en": "Focus right" } },
    { "keys": "Win+Up", "do": "do:focus up", "group": "tiling", "label": { "de": "Fokus nach oben", "en": "Focus up" } },
    { "keys": "Win+Down", "do": "do:focus down", "group": "tiling", "label": { "de": "Fokus nach unten", "en": "Focus down" } },
    { "keys": "Win+Shift+Left", "do": "do:swap left", "group": "tiling", "label": { "de": "Fenster nach links tauschen", "en": "Swap window left" } },
    { "keys": "Win+Shift+Right", "do": "do:swap right", "group": "tiling", "label": { "de": "Fenster nach rechts tauschen", "en": "Swap window right" } },
    { "keys": "Win+Shift+Up", "do": "do:swap up", "group": "tiling", "label": { "de": "Fenster nach oben tauschen", "en": "Swap window up" } },
    { "keys": "Win+Shift+Down", "do": "do:swap down", "group": "tiling", "label": { "de": "Fenster nach unten tauschen", "en": "Swap window down" } },

    { "keys": "Win+M", "do": "do:restore-minimized", "group": "tiling", "omarchy": "– (Omarchy minimiert nicht)", "label": { "de": "Minimierte Fenster zurückholen", "en": "Restore minimized windows" }, "note": { "de": "Falls doch einmal etwas minimiert wurde.", "en": "In case something got minimized after all." } },
    { "keys": "Win+S", "do": "do:scratch-toggle", "group": "tiling", "label": { "de": "Scratchpad zeigen oder verstecken", "en": "Toggle scratchpad" } },
    { "keys": "Win+Alt+S", "do": "do:scratch-store", "group": "tiling", "label": { "de": "Fenster ins Scratchpad oder wieder heraus", "en": "Window into the scratchpad or back out" }, "note": { "de": "Auf einem Scratchpad-Fenster holt es das Fenster zurück in die Kacheln.", "en": "On a scratchpad window it puts the window back into the tiles." } },
    { "keys": "Win+Shift+Backspace", "do": "do:gaps-toggle", "group": "tiling", "optional": true, "label": { "de": "Abstände ein oder aus", "en": "Toggle gaps" } },
    { "keys": "Win+Shift+Alt+R", "do": "do:reload", "group": "tiling", "optional": true, "label": { "de": "GlazeWM neu laden", "en": "Reload GlazeWM" } },
    { "keys": "Win+Shift+Alt+P", "do": "wm:wm-toggle-pause", "group": "tiling", "optional": true, "label": { "de": "Tiling pausieren", "en": "Pause tiling" } },

    { "keys": "Win+{n}", "repeat": "workspaces", "do": "wm:focus --workspace {ws}", "group": "workspaces", "label": { "de": "Workspace {ws}", "en": "Workspace {ws}" } },
    { "keys": "Win+Shift+{n}", "repeat": "workspaces", "do": "do:to-workspace {ws}", "group": "workspaces", "label": { "de": "Fenster auf Workspace {ws}", "en": "Move window to workspace {ws}" } },
    { "keys": "Win+Tab", "do": "do:workspace-next", "group": "workspaces", "label": { "de": "Nächster Workspace", "en": "Next workspace" } },
    { "keys": "Win+Shift+Tab", "do": "do:workspace-prev", "group": "workspaces", "label": { "de": "Vorheriger Workspace", "en": "Previous workspace" } },
    { "keys": "Win+Ctrl+Tab", "do": "wm:focus --recent-workspace", "group": "workspaces", "optional": true, "label": { "de": "Zuletzt benutzter Workspace", "en": "Former workspace" } },
    { "keys": "Win+Ctrl+D", "do": "do:work-mode 1", "group": "workspaces", "label": { "de": "Arbeitsmodus 1: frische Workspaces mit seinen Programmen", "en": "Work mode 1: fresh workspaces with its programs" }, "note": { "de": "Die offenen Fenster bleiben auf ihren Workspaces. Nochmal drücken: zurück. Programme legst du unter Tiling fest.", "en": "Open windows stay on their workspaces. Press again to go back. Programs are set under Tiling." } },
    { "keys": "Win+Ctrl+1", "do": "do:work-mode 1", "group": "workspaces", "optional": true, "label": { "de": "Arbeitsmodus 1", "en": "Work mode 1" } },
    { "keys": "Win+Ctrl+2", "do": "do:work-mode 2", "group": "workspaces", "label": { "de": "Arbeitsmodus 2", "en": "Work mode 2" }, "note": { "de": "Etwa Recherche neben den aktiven Tools in Modus 1.", "en": "For example research next to the active tools in mode 1." } },
    { "keys": "Win+Ctrl+3", "do": "do:work-mode 3", "group": "workspaces", "label": { "de": "Arbeitsmodus 3", "en": "Work mode 3" } },
    { "keys": "Win+Ctrl+Right", "do": "do:desktop-next", "group": "workspaces", "label": { "de": "Alle Bildschirme: nächster Workspace", "en": "All monitors: next workspace" }, "note": { "de": "Lässt sich aufs Drei-Finger-Wischen legen.", "en": "Can go on the three-finger swipe." } },
    { "keys": "Win+Ctrl+Left", "do": "do:desktop-prev", "group": "workspaces", "label": { "de": "Alle Bildschirme: vorheriger Workspace", "en": "All monitors: previous workspace" }, "note": { "de": "Lässt sich aufs Drei-Finger-Wischen legen.", "en": "Can go on the three-finger swipe." } },
    { "keys": "Win+WheelDown", "do": "do:workspace-next", "group": "workspaces", "optional": true, "label": { "de": "Nächster Workspace (Mausrad)", "en": "Next workspace (wheel)" } },
    { "keys": "Win+WheelUp", "do": "do:workspace-prev", "group": "workspaces", "optional": true, "label": { "de": "Vorheriger Workspace (Mausrad)", "en": "Previous workspace (wheel)" } },

    { "keys": "Win+Enter", "do": "app:terminal", "group": "apps", "label": { "de": "Terminal", "en": "Terminal" } },
    { "keys": "Win+Shift+Enter", "do": "app:browser2", "group": "apps", "label": { "de": "Zweiter Browser", "en": "Second browser" }, "note": { "de": "Welcher Browser, legst du in den Einstellungen fest.", "en": "Pick the browser in the settings." } },
    { "keys": "Win+Shift+B", "do": "app:browser", "group": "apps", "label": { "de": "Browser", "en": "Browser" } },
    { "keys": "Win+Shift+Alt+B", "do": "app:browser-private", "group": "apps", "optional": true, "label": { "de": "Browser (privat)", "en": "Browser (private)" } },
    { "keys": "Win+Shift+F", "do": "app:files", "group": "apps", "label": { "de": "Dateimanager", "en": "File manager" } },
    { "keys": "Win+N", "do": "app:notepad", "group": "apps", "label": { "de": "Editor", "en": "Notepad" } },
    { "keys": "Win+Shift+N", "do": "app:editor", "group": "apps", "omarchy": "SUPER + SHIFT + N (Neovim)", "label": { "de": "Code-Editor (VS Code)", "en": "Code editor (VS Code)" } },
    { "keys": "Win+Ctrl+Enter", "do": "app:herdr", "group": "apps", "label": { "de": "Herdr", "en": "Herdr" } },
    { "keys": "Win+Alt+Enter", "do": "app:pi", "group": "apps", "label": { "de": "Pi (Coding-Agent)", "en": "Pi (coding agent)" } },
    { "keys": "Win+Shift+M", "do": "web:https://open.spotify.com/", "group": "apps", "label": { "de": "Spotify (Web-App)", "en": "Spotify (web app)" } },
    { "keys": "Win+Shift+Q", "do": "app:calculator", "group": "apps", "label": { "de": "Rechner", "en": "Calculator" } },
    { "keys": "Win+Shift+T", "do": "app:taskmanager", "group": "apps", "omarchy": "SUPER + SHIFT + T (btop)", "label": { "de": "Task-Manager", "en": "Task Manager" } },
    { "keys": "Win+Shift+E", "do": "app:mail", "group": "apps", "omarchy": "SUPER + SHIFT + E (HEY)", "label": { "de": "E-Mail (Outlook)", "en": "Email (Outlook)" } },
    { "keys": "Win+Shift+Alt+E", "do": "open:mailto:", "group": "apps", "optional": true, "label": { "de": "Neue E-Mail", "en": "New email" } },
    { "keys": "Win+Shift+C", "do": "app:calendar", "group": "apps", "omarchy": "SUPER + SHIFT + C (HEY Calendar)", "label": { "de": "Kalender", "en": "Calendar" } },
    { "keys": "Win+Shift+G", "do": "app:stackfield", "group": "apps", "omarchy": "SUPER + SHIFT + G (Signal)", "label": { "de": "Stackfield", "en": "Stackfield" } },
    { "keys": "Win+Shift+O", "do": "app:notes", "group": "apps", "omarchy": "SUPER + SHIFT + O (Obsidian)", "label": { "de": "Notizen (OneNote)", "en": "Notes (OneNote)" } },
    { "keys": "Win+Shift+W", "do": "app:word", "group": "apps", "omarchy": "SUPER + SHIFT + W (Omawrite)", "label": { "de": "Schreiben (Word)", "en": "Writing (Word)" } },
    { "keys": "Win+Alt+P", "do": "app:winmarchy", "group": "apps", "label": { "de": "WinMarchy öffnen", "en": "Open WinMarchy" } },

    { "keys": "Win+Space", "do": "do:menu", "group": "menus", "omarchy": "SUPER + ALT + SPACE und SUPER + SPACE", "label": { "de": "WinMarchy-Menü und Programme", "en": "WinMarchy menu and apps" }, "note": { "de": "Tippen sucht auch in den Programmen des Startmenüs. Win allein öffnet Flow Launcher.", "en": "Typing also searches the Start menu apps. Win alone opens Flow Launcher." } },
    { "keys": "Win+Escape", "do": "do:menu system", "group": "menus", "label": { "de": "Systemmenü", "en": "System menu" } },
    { "keys": "Win+K", "do": "do:keybindings", "group": "menus", "label": { "de": "Tastenkürzel anzeigen", "en": "Show keybindings" } },
    { "keys": "Win+Ctrl+T", "do": "do:theme-menu", "group": "menus", "omarchy": "SUPER + CTRL + SHIFT + SPACE", "label": { "de": "Theme wählen", "en": "Theme menu" } },
    { "keys": "Win+Ctrl+Space", "do": "do:wallpaper-next", "group": "menus", "label": { "de": "Nächstes Hintergrundbild", "en": "Next background" } },
    { "keys": "Win+Ctrl+Alt+Space", "do": "do:wallpaper-menu", "group": "menus", "label": { "de": "Hintergrund wählen", "en": "Choose background" } },
    { "keys": "Win+Shift+Space", "do": "do:bar-toggle", "group": "menus", "optional": true, "label": { "de": "Leiste ein oder aus", "en": "Toggle top bar" } },
    { "keys": "Win+Ctrl+C", "do": "do:menu capture", "group": "menus", "optional": true, "label": { "de": "Aufnahme-Menü", "en": "Capture menu" } },
    { "keys": "Win+Ctrl+O", "do": "do:menu toggle", "group": "menus", "optional": true, "label": { "de": "Schalter-Menü", "en": "Toggle menu" } },
    { "keys": "Win+Ctrl+H", "do": "do:menu hardware", "group": "menus", "optional": true, "label": { "de": "Hardware-Menü", "en": "Hardware menu" } },
    { "keys": "Win+Ctrl+E", "do": "send:Win+Period", "group": "menus", "label": { "de": "Emojis", "en": "Emojis" } },
    { "keys": "Win+Alt+D", "do": "do:bar-menu calendar", "group": "menus", "optional": true, "label": { "de": "Kalender der Leiste", "en": "Bar calendar" }, "note": { "de": "nur mit YASB", "en": "YASB only" } },
    { "keys": "Win+Alt+A", "do": "do:bar-menu audio", "group": "menus", "optional": true, "label": { "de": "Lautstärke der Leiste", "en": "Bar volume" }, "note": { "de": "nur mit YASB", "en": "YASB only" } },

    { "keys": "Win+C", "do": "do:copy", "group": "utilities", "label": { "de": "Kopieren (auch im Terminal)", "en": "Universal copy" } },
    { "keys": "Win+V", "do": "do:paste", "group": "utilities", "label": { "de": "Einfügen (auch im Terminal)", "en": "Universal paste" } },
    { "keys": "Win+X", "do": "send:Ctrl+X", "group": "utilities", "label": { "de": "Ausschneiden", "en": "Universal cut" } },
    { "keys": "Win+A", "do": "send:Ctrl+A", "group": "utilities", "label": { "de": "Alles markieren", "en": "Select all" } },
    { "keys": "Win+Ctrl+V", "do": "send:Win+V", "group": "utilities", "label": { "de": "Zwischenablage-Verlauf", "en": "Clipboard history" } },
    { "keys": "Win+Ctrl+M", "do": "send:MediaPlayPause", "group": "utilities", "label": { "de": "Musik abspielen oder anhalten", "en": "Play or pause music" } },
    { "keys": "PrintScreen", "do": "do:screenshot", "group": "utilities", "label": { "de": "Bildschirmfoto", "en": "Screenshot" }, "note": { "de": "Mit Windows oder Greenshot, je nach Einstellung.", "en": "With Windows or Greenshot, as set." } },
    { "keys": "Win+Ctrl+Alt+C", "do": "do:screenshot", "group": "utilities", "label": { "de": "Bildschirmfoto", "en": "Screenshot" } },
    { "keys": "Alt+PrintScreen", "do": "send:Win+Shift+R", "group": "utilities", "label": { "de": "Bildschirmaufnahme", "en": "Screen recording" } },
    { "keys": "Win+Comma", "do": "send:Win+N", "group": "utilities", "label": { "de": "Benachrichtigungen", "en": "Notifications" } },
    { "keys": "Win+Slash", "do": "do:scale-up", "group": "utilities", "optional": true, "label": { "de": "Skalierung größer", "en": "Monitor scaling up" } },
    { "keys": "Win+Alt+Slash", "do": "do:scale-down", "group": "utilities", "optional": true, "label": { "de": "Skalierung kleiner", "en": "Monitor scaling down" } },
    { "keys": "Win+Ctrl+Z", "do": "send:Win+NumpadAdd", "group": "utilities", "optional": true, "label": { "de": "Lupe vergrößern", "en": "Zoom in" } },
    { "keys": "Win+Ctrl+Alt+Z", "do": "send:Win+Escape", "group": "utilities", "optional": true, "label": { "de": "Lupe beenden", "en": "Reset zoom" } },
    { "keys": "Win+Ctrl+Alt+T", "do": "do:show-time", "group": "utilities", "optional": true, "label": { "de": "Uhrzeit zeigen", "en": "Show time" } },
    { "keys": "Win+Ctrl+Alt+B", "do": "do:show-battery", "group": "utilities", "optional": true, "label": { "de": "Akku zeigen", "en": "Show battery" } },
    { "keys": "Win+Ctrl+Alt+D", "do": "send:Win+Alt+D", "group": "utilities", "optional": true, "label": { "de": "Kalender aufklappen", "en": "Calendar flyout" } },
    { "keys": "Win+Ctrl+Alt+E", "do": "open:ms-clock:", "group": "utilities", "optional": true, "label": { "de": "Weltuhr", "en": "World clock" } },

    { "keys": "Win+Ctrl+L", "do": "do:lock", "group": "system", "label": { "de": "Sperren", "en": "Lock" } },
    { "keys": "Win+Ctrl+I", "do": "do:keep-awake", "group": "system", "optional": true, "omarchy": "SUPER + CTRL + I (Idle-Sperre)", "label": { "de": "Bildschirm wach halten", "en": "Keep display awake" } },
    { "keys": "Win+Ctrl+A", "do": "open:ms-settings:sound", "group": "system", "optional": true, "label": { "de": "Audio", "en": "Audio" } },
    { "keys": "Win+Ctrl+B", "do": "open:ms-settings:bluetooth", "group": "system", "optional": true, "label": { "de": "Bluetooth", "en": "Bluetooth" } },
    { "keys": "Win+Ctrl+Shift+D", "do": "open:ms-settings:display", "group": "system", "optional": true, "label": { "de": "Anzeige", "en": "Display" } },
    { "keys": "Win+Ctrl+N", "do": "open:ms-availablenetworks:", "group": "system", "optional": true, "label": { "de": "Netzwerk", "en": "Network" } },
    { "keys": "Win+Ctrl+P", "do": "open:ms-settings:powersleep", "group": "system", "optional": true, "label": { "de": "Energie", "en": "Power" } },
    { "keys": "Ctrl+Alt+Shift+T", "do": "do:taskbar-toggle", "group": "system", "optional": true, "label": { "de": "Windows-Taskleiste ein oder aus", "en": "Toggle Windows taskbar" } }
  ]
}
