    { "keys": "Win+Home", "do": "do:restore-minimized", "group": "tiling", "omarchy": "SUPER + HOME", "label": { "de": "Minimierte Fenster zurückholen", "en": "Restore minimized windows" }, "note": { "de": "Omarchy stellt hier die gespeicherte Fensterbreite wieder her; das kann GlazeWM nicht.", "en": "Omarchy restores a saved window width here; GlazeWM cannot." } },
    { "keys": "Win+S", "do": "do:scratch-toggle", "group": "tiling", "label": { "de": "Scratchpad zeigen oder verstecken", "en": "Toggle scratchpad" } },
