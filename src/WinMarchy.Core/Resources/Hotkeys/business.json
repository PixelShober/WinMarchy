    { "keys": "Win+Alt+L", "do": "do:layout-next", "group": "tiling", "omarchy": "SUPER + L", "label": { "de": "Layout des Workspace wechseln", "en": "Cycle workspace layout" }, "note": { "de": "Win+L sperrt unter Windows immer den Rechner.", "en": "Win+L always locks the PC on Windows." } },
    { "keys": "Win+Alt+Shift+L", "do": "do:layout-prev", "group": "tiling", "omarchy": "SUPER + ALT + L", "label": { "de": "Layout zurück", "en": "Cycle layout back" } },

    { "keys": "Win+Left", "do": "wm:focus --direction left", "group": "tiling", "label": { "de": "Fokus nach links", "en": "Focus left" } },
