    { "keys": "Win+Shift+Right", "do": "wm:move --direction right", "group": "tiling", "label": { "de": "Fenster nach rechts tauschen", "en": "Swap window right" } },
    { "keys": "Win+Shift+Up", "do": "wm:move --direction up", "group": "tiling", "label": { "de": "Fenster nach oben tauschen", "en": "Swap window up" } },
    { "keys": "Win+Shift+Down", "do": "wm:move --direction down", "group": "tiling", "label": { "de": "Fenster nach unten tauschen", "en": "Swap window down" } },

    { "keys": "Win+Minus", "do": "wm:resize --width -100px", "group": "tiling", "label": { "de": "Schmaler", "en": "Narrower" } },
    { "keys": "Win+Equal", "do": "wm:resize --width +100px", "group": "tiling", "label": { "de": "Breiter", "en": "Wider" } },
    { "keys": "Win+Shift+Minus", "do": "wm:resize --height -100px", "group": "tiling", "label": { "de": "Niedriger", "en": "Shorter" } },
    { "keys": "Win+Shift+Equal", "do": "wm:resize --height +100px", "group": "tiling", "label": { "de": "Höher", "en": "Taller" } },
