    { "keys": "Win+J", "do": "wm:toggle-tiling-direction", "group": "tiling", "label": { "de": "Teilung drehen", "en": "Toggle split" } },
    { "keys": "Win+T", "do": "wm:toggle-floating --centered", "group": "tiling", "label": { "de": "Schwebend oder gekachelt", "en": "Toggle floating" } },
    { "keys": "Win+F", "do": "wm:toggle-fullscreen", "group": "tiling", "label": { "de": "Vollbild", "en": "Full screen" } },
    { "keys": "Win+Alt+F", "do": "wm:toggle-fullscreen --maximized", "group": "tiling", "label": { "de": "Volle Breite", "en": "Full width" } },
