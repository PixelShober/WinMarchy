<Window x:Class="WinMarchy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinMarchy.App.Ui"
        Title="WinMarchy" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource Text}" Background="{DynamicResource Bg}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
  <Grid x:Name="Root">
    <Grid x:Name="Shell">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar: a second, darker neutral layer. The active tab has a 2 px accent bar that glides
           between tabs – GlazeWM's focused-window border, turned into navigation. -->
      <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,16,12,14">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,20">
            <Image Source="pack://application:,,,/Assets/winmarchy.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="WinMarchy" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="{ui:T app.tagline}" Style="{StaticResource Small}" />
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="6,12,0,0">
            <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SchemeSystem" Style="{StaticResource Segment}" GroupName="scheme" ToolTip="{ui:T appearance.system}"
                             AutomationProperties.Name="{ui:T appearance.system}" Checked="OnScheme" Tag="system">
                  <ui:Icon Kind="monitor" Size="15" />
                </RadioButton>
                <RadioButton x:Name="SchemeLight" Style="{StaticResource Segment}" GroupName="scheme" ToolTip="{ui:T appearance.light}"
                             AutomationProperties.Name="{ui:T appearance.light}" Checked="OnScheme" Tag="light">
                  <ui:Icon Kind="sun" Size="15" />
                </RadioButton>
                <RadioButton x:Name="SchemeDark" Style="{StaticResource Segment}" GroupName="scheme" ToolTip="{ui:T appearance.dark}"
                             AutomationProperties.Name="{ui:T appearance.dark}" Checked="OnScheme" Tag="dark">
                  <ui:Icon Kind="moon" Size="15" />
                </RadioButton>
              </StackPanel>
            </Border>
            <Border x:Name="StatusPill" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    Padding="10,5" HorizontalAlignment="Left" Cursor="Hand" MouseLeftButtonUp="OnStatusClick">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="VersionText" Style="{StaticResource Small}" Margin="0,8,0,0" />
          </StackPanel>

          <Grid>
            <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False">
              <Border x:Name="Marker" Width="208" Background="{DynamicResource AccentSoft}">
                <Border HorizontalAlignment="Left" Width="2" Background="{DynamicResource Accent}" />
              </Border>
            </Canvas>
            <StackPanel x:Name="Nav">
              <RadioButton x:Name="NavStart" Style="{StaticResource NavItem}" Tag="home" Content="{ui:T nav.start}" Checked="OnNav" />
              <RadioButton x:Name="NavSetup" Style="{StaticResource NavItem}" Tag="setup" Content="{ui:T nav.setup}" Checked="OnNav" />
              <RadioButton x:Name="NavThemes" Style="{StaticResource NavItem}" Tag="themes" Content="{ui:T nav.themes}" Checked="OnNav" />
              <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" Tag="keyboard" Content="{ui:T nav.hotkeys}" Checked="OnNav" />
              <RadioButton x:Name="NavTiling" Style="{StaticResource NavItem}" Tag="tiling" Content="{ui:T nav.tiling}" Checked="OnNav" />
              <RadioButton x:Name="NavRestore" Style="{StaticResource NavItem}" Tag="undo" Content="{ui:T nav.restore}" Checked="OnNav" />
              <Border Style="{StaticResource Separator}" Margin="6,8" />
              <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="settings" Content="{ui:T nav.settings}" Checked="OnNav" />
              <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" Tag="log" Content="{ui:T nav.log}" Checked="OnNav" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" Padding="36,10">
          <DockPanel>
            <Button x:Name="UpdateRestart" DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{ui:T update.restartNow}" Click="OnUpdateRestart" />
            <TextBlock x:Name="UpdateText" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,12,0" />
          </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ContentControl x:Name="Page" Margin="36,28,36,48" MaxWidth="1040" HorizontalAlignment="Left" Focusable="False" />
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Above everything: snapshots for the page change and the reveal, toasts, dialogs. -->
    <Grid x:Name="OverlayHost" IsHitTestVisible="False" />
    <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Width="380" />
    <Grid x:Name="DialogHost" Visibility="Collapsed" Background="{DynamicResource Backdrop}" />
  </Grid>
</Window>
