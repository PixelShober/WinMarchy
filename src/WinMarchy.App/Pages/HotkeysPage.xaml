<UserControl x:Class="WinMarchy.App.Pages.HotkeysPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinMarchy.App.Ui">
  <StackPanel>
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,22">
      <TextBlock Text="{ui:T hotkeys.title}" Style="{StaticResource H1}" />
      <TextBlock Text="{ui:T hotkeys.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{ui:T hotkeys.engine}" Style="{StaticResource H2}" />
          <Border Style="{StaticResource SegmentGroup}" Margin="0,12,0,10">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="EngineAhk" Style="{StaticResource Segment}" GroupName="engine" Content="{ui:T hotkeys.engineAhk}" Checked="OnEngine" Tag="autohotkey" />
              <RadioButton x:Name="EngineGlaze" Style="{StaticResource Segment}" GroupName="engine" Content="{ui:T hotkeys.engineGlaze}" Checked="OnEngine" Tag="glazewm" />
            </StackPanel>
          </Border>
          <TextBlock x:Name="EngineText" Style="{StaticResource Muted}" />
          <CheckBox x:Name="WinAlone" Style="{StaticResource Switch}" Margin="0,14,0,0" Click="OnWinAlone">
            <StackPanel>
              <TextBlock Text="{ui:T hotkeys.winAlone}" Style="{StaticResource Body}" />
              <TextBlock Text="{ui:T hotkeys.winAloneHint}" Style="{StaticResource Small}" />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{ui:T hotkeys.profiles}" Style="{StaticResource H2}" />
          <TextBlock Text="{ui:T hotkeys.profilesText}" Style="{StaticResource Muted}" Margin="0,6,0,14" />
          <CheckBox x:Name="Personal" Style="{StaticResource Switch}" Click="OnPersonal">
            <StackPanel>
              <TextBlock Text="{ui:T hotkeys.personal}" Style="{StaticResource Body}" />
              <TextBlock Text="{ui:T hotkeys.personalHint}" Style="{StaticResource Small}" />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </Border>
    </Grid>

    <Border x:Name="Problems" Background="{DynamicResource WarnSoft}" Padding="16,12" Margin="0,20,0,0" Visibility="Collapsed">
      <DockPanel>
        <ui:Icon Kind="alert" Size="16" Foreground="{DynamicResource Warn}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,10,0" />
        <TextBlock x:Name="ProblemsText" Style="{StaticResource Body}" />
      </DockPanel>
    </Border>

    <!-- Editor for a new or changed shortcut. Shown above the list while editing. -->
    <Border x:Name="Editor" Style="{StaticResource Card}" Margin="0,20,0,0" Visibility="Collapsed" BorderBrush="{DynamicResource Accent}">
      <StackPanel>
        <TextBlock x:Name="EditorTitle" Style="{StaticResource H2}" Margin="0,0,0,14" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{ui:T hotkeys.edit.keys}" Style="{StaticResource H3}" Margin="0,0,0,4" />
          <TextBox x:Name="EditKeys" Grid.Row="1" Style="{StaticResource MonoBox}" />
          <TextBlock Grid.Row="2" Text="{ui:T hotkeys.edit.keysHint}" Style="{StaticResource Small}" Margin="0,4,0,0" />
          <TextBlock Grid.Column="2" Text="{ui:T hotkeys.edit.kind}" Style="{StaticResource H3}" Margin="0,0,0,4" />
          <ComboBox x:Name="EditKind" Grid.Column="2" Grid.Row="1" SelectionChanged="OnKindChanged" />
          <TextBlock Grid.Column="4" Text="{ui:T hotkeys.edit.value}" Style="{StaticResource H3}" Margin="0,0,0,4" />
          <Grid Grid.Column="4" Grid.Row="1">
            <TextBox x:Name="EditValue" Style="{StaticResource MonoBox}" />
            <ComboBox x:Name="EditChoice" Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="EditValueHint" Grid.Column="4" Grid.Row="2" Style="{StaticResource Small}" Margin="0,4,0,0" />
          <StackPanel Grid.Row="3" Grid.ColumnSpan="5" Margin="0,14,0,0">
            <TextBlock Text="{ui:T hotkeys.edit.label}" Style="{StaticResource H3}" Margin="0,0,0,4" />
            <TextBox x:Name="EditLabel" />
          </StackPanel>
        </Grid>
        <TextBlock x:Name="EditError" Style="{StaticResource Small}" Foreground="{DynamicResource Error}" Margin="0,10,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Style="{StaticResource Primary}" Content="{ui:T hotkeys.edit.save}" Click="OnEditSave" />
          <Button Content="{ui:T common.cancel}" Margin="8,0,0,0" Click="OnEditCancel" />
        </StackPanel>
      </StackPanel>
    </Border>

    <DockPanel Margin="0,26,0,12">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="{ui:T hotkeys.export}" Click="OnExport" Margin="0,0,8,0" ToolTip="{ui:T hotkeys.exportTip}" />
        <Button Content="{ui:T hotkeys.import}" Click="OnImport" Margin="0,0,8,0" ToolTip="{ui:T hotkeys.importTip}" />
        <Button Click="OnAdd" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <ui:Icon Kind="plus" Size="13" VerticalAlignment="Center" />
            <TextBlock Text="{ui:T hotkeys.add}" Margin="6,0,0,0" />
          </StackPanel>
        </Button>
        <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="{ui:T hotkeys.apply}" Click="OnApply" />
      </StackPanel>
      <Grid Width="280" HorizontalAlignment="Left">
        <TextBox x:Name="Search" Padding="30,5,8,5" TextChanged="OnSearch" AutomationProperties.Name="{ui:T hotkeys.search}" />
        <ui:Icon Kind="search" Size="14" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
        <TextBlock x:Name="SearchHint" Text="{ui:T hotkeys.search}" Style="{StaticResource Muted}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Grid>
    </DockPanel>
    <Border Style="{StaticResource SegmentGroup}" Margin="0,0,0,14">
      <StackPanel x:Name="Groups" Orientation="Horizontal" />
    </Border>

    <ui:JobView x:Name="Job" Margin="0,0,0,14" />

    <Border Style="{StaticResource Card}" Padding="0">
      <StackPanel x:Name="List" />
    </Border>
  </StackPanel>
</UserControl>
