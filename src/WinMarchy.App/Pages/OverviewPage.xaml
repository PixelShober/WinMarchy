<UserControl x:Class="WinMarchy.App.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinMarchy.App.Ui">
  <StackPanel>
    <DockPanel Margin="0,0,0,22">
      <Button DockPanel.Dock="Right" VerticalAlignment="Top" Click="OnRefresh">
        <StackPanel Orientation="Horizontal">
          <ui:Icon Kind="refresh" Size="14" />
          <TextBlock Text="{ui:T overview.refresh}" Margin="6,0,0,0" />
        </StackPanel>
      </Button>
      <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{ui:T overview.title}" Style="{StaticResource H1}" />
        <TextBlock Text="{ui:T overview.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
      </StackPanel>
    </DockPanel>

    <Border x:Name="SetupNote" Background="{DynamicResource AccentSoft}" Padding="18,14" Margin="0,0,0,18" Visibility="Collapsed">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="{ui:T overview.setupNow}" Click="OnSetup" VerticalAlignment="Center" Margin="16,0,0,0" />
        <ui:Icon Kind="info" Size="16" Foreground="{DynamicResource AccentFg}" VerticalAlignment="Top" Margin="0,2,10,0" DockPanel.Dock="Left" />
        <StackPanel>
          <TextBlock Text="{ui:T overview.notSetUp}" Style="{StaticResource H3}" />
          <TextBlock x:Name="SetupNoteText" Text="{ui:T overview.notSetUpText}" Style="{StaticResource Body}" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Grid.Column="0" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{ui:T overview.programs}" Style="{StaticResource H2}" Margin="0,0,0,12" />
          <Grid x:Name="ToolTable" />
          <TextBlock Text="{ui:T overview.programsHint}" Style="{StaticResource Small}" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{ui:T overview.changeTheme}" Click="OnThemes" VerticalAlignment="Top" />
              <StackPanel>
                <TextBlock Text="{ui:T overview.theme}" Style="{StaticResource Small}" />
                <TextBlock x:Name="ThemeName" Style="{StaticResource H2}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
            <Border x:Name="PreviewFrame" Margin="0,14,0,0" BorderBrush="{DynamicResource Border}" BorderThickness="1" Height="150" ClipToBounds="True">
              <Grid>
                <Image x:Name="Preview" Stretch="UniformToFill" />
                <UniformGrid x:Name="PaletteBig" Rows="1" />
              </Grid>
            </Border>
            <UniformGrid x:Name="Palette" Rows="1" Height="14" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,20,0,0">
          <StackPanel>
            <TextBlock Text="{ui:T overview.workspace}" Style="{StaticResource Small}" />
            <TextBlock x:Name="WorkspaceText" Style="{StaticResource H2}" Margin="0,2,0,0" />
            <TextBlock x:Name="WorkspaceHint" Style="{StaticResource Muted}" Margin="0,6,0,0" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
