<UserControl x:Class="WinMarchy.App.Pages.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinMarchy.App.Ui">
  <StackPanel>
    <DockPanel Margin="0,0,0,22">
      <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="{ui:T restore.openFolder}" Click="OnOpenFolder" />
      <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{ui:T restore.title}" Style="{StaticResource H1}" />
        <TextBlock Text="{ui:T restore.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
      </StackPanel>
    </DockPanel>

    <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Error}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="20,0,0,0">
          <Button x:Name="ResetAll" Style="{StaticResource Danger}" Content="{ui:T restore.resetAll}" Click="OnResetAll" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{ui:T restore.original}" Style="{StaticResource H2}" />
          <TextBlock x:Name="OriginalText" Style="{StaticResource Muted}" Margin="0,6,0,14" />
          <CheckBox x:Name="RemoveTools" Style="{StaticResource Switch}">
            <StackPanel>
              <TextBlock Text="{ui:T restore.removeTools}" Style="{StaticResource Body}" />
              <TextBlock x:Name="RemoveToolsHint" Style="{StaticResource Small}" />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <ui:JobView x:Name="Job" Margin="0,20,0,0" />

    <TextBlock Text="{ui:T restore.points}" Style="{StaticResource H2}" Margin="0,26,0,4" />
    <TextBlock Text="{ui:T restore.pointsText}" Style="{StaticResource Muted}" Margin="0,0,0,12" />
    <Border Style="{StaticResource Card}" Padding="0">
      <StackPanel x:Name="Points" />
    </Border>
  </StackPanel>
</UserControl>
