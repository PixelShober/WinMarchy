<UserControl x:Class="WinMarchy.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinMarchy.App.Ui">
  <StackPanel MaxWidth="860" HorizontalAlignment="Left">
    <StackPanel Margin="0,0,0,22">
      <TextBlock Text="{ui:T settings.title}" Style="{StaticResource H1}" />
      <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{ui:T settings.appearance}" Style="{StaticResource H2}" />
        <TextBlock Text="{ui:T settings.appearanceText}" Style="{StaticResource Muted}" Margin="0,4,0,14" />
        <Border Style="{StaticResource SegmentGroup}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="CardSystem" Style="{StaticResource Segment}" GroupName="scheme-card" Tag="system" Checked="OnScheme" MinHeight="34" Padding="12,0">
              <StackPanel Orientation="Horizontal"><ui:Icon Kind="monitor" Size="15" /><TextBlock Text="{ui:T appearance.system}" Margin="8,0,0,0" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="CardLight" Style="{StaticResource Segment}" GroupName="scheme-card" Tag="light" Checked="OnScheme" MinHeight="34" Padding="12,0">
              <StackPanel Orientation="Horizontal"><ui:Icon Kind="sun" Size="15" /><TextBlock Text="{ui:T appearance.light}" Margin="8,0,0,0" /></StackPanel>
            </RadioButton>
            <RadioButton x:Name="CardDark" Style="{StaticResource Segment}" GroupName="scheme-card" Tag="dark" Checked="OnScheme" MinHeight="34" Padding="12,0">
              <StackPanel Orientation="Horizontal"><ui:Icon Kind="moon" Size="15" /><TextBlock Text="{ui:T appearance.dark}" Margin="8,0,0,0" /></StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
        <TextBlock Text="{ui:T settings.language}" Style="{StaticResource H3}" Margin="0,18,0,4" />
        <ComboBox x:Name="LanguageBox" Width="240" HorizontalAlignment="Left" SelectionChanged="OnLanguage" />
        <TextBlock x:Name="LanguageHint" Text="{ui:T settings.languageHint}" Style="{StaticResource Small}" Margin="0,4,0,0" Visibility="Collapsed" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{ui:T settings.checkUpdates}" Click="OnCheckUpdates" VerticalAlignment="Top" />
          <StackPanel>
            <TextBlock Text="{ui:T settings.updates}" Style="{StaticResource H2}" />
            <TextBlock x:Name="UpdateText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
          </StackPanel>
        </DockPanel>
        <CheckBox x:Name="AutoUpdate" Style="{StaticResource Switch}" Margin="0,16,0,0" Click="OnAutoUpdate">
          <StackPanel>
            <TextBlock Text="{ui:T settings.autoUpdate}" Style="{StaticResource Body}" />
            <TextBlock Text="{ui:T settings.autoUpdateHint}" Style="{StaticResource Small}" />
          </StackPanel>
        </CheckBox>
        <DockPanel Margin="0,16,0,0">
          <Button DockPanel.Dock="Right" Content="{ui:T settings.toolUpdates}" Click="OnToolUpdates" VerticalAlignment="Top" Margin="12,0,0,0" />
          <TextBlock Text="{ui:T settings.toolUpdatesHint}" Style="{StaticResource Small}" TextWrapping="Wrap" />
        </DockPanel>
        <ui:JobView x:Name="ToolsJob" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="{ui:T settings.fileManager}" Style="{StaticResource H2}" />
        <TextBlock Text="{ui:T settings.fileManagerText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
        <CheckBox x:Name="FilesDefaultSwitch" Style="{StaticResource Switch}" Click="OnFilesDefault">
          <StackPanel>
            <TextBlock Text="{ui:T settings.filesDefault}" Style="{StaticResource Body}" />
            <TextBlock x:Name="FilesDefaultHint" Style="{StaticResource Small}" TextWrapping="Wrap" />
          </StackPanel>
        </CheckBox>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="{ui:T settings.browsers}" Style="{StaticResource H2}" />
        <TextBlock Text="{ui:T settings.browsersText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{ui:T settings.browser1}" Style="{StaticResource H3}" Margin="0,0,0,4" />
            <ComboBox x:Name="Browser1" SelectionChanged="OnBrowser" Tag="1" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{ui:T settings.browser2}" Style="{StaticResource H3}" Margin="0,0,0,4" />
            <ComboBox x:Name="Browser2" SelectionChanged="OnBrowser" Tag="2" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="{ui:T settings.screenshots}" Style="{StaticResource H2}" />
        <TextBlock Text="{ui:T settings.screenshotsText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ShotWindows" Style="{StaticResource Segment}" GroupName="shots" Tag="windows" Checked="OnScreenshotTool" Content="{ui:T settings.screenshotWindows}" />
            <RadioButton x:Name="ShotGreenshot" Style="{StaticResource Segment}" GroupName="shots" Tag="greenshot" Checked="OnScreenshotTool" Content="{ui:T settings.screenshotGreenshot}" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="ShotHint" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <ui:JobView x:Name="ShotJob" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="{ui:T settings.glaze}" Style="{StaticResource H2}" />
        <TextBlock Text="{ui:T settings.glazeText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="GlazeWinMarchy" Style="{StaticResource Segment}" GroupName="glaze" Tag="winmarchy" Checked="OnGlazeBuild" Content="{ui:T settings.glazeWinMarchy}" />
            <RadioButton x:Name="GlazeOfficial" Style="{StaticResource Segment}" GroupName="glaze" Tag="official" Checked="OnGlazeBuild" Content="{ui:T settings.glazeOfficial}" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="GlazeHint" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <ui:JobView x:Name="GlazeJob" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="{ui:T settings.bar}" Style="{StaticResource H2}" />
        <TextBlock Text="{ui:T settings.barText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="BarYasb" Style="{StaticResource Segment}" GroupName="bar" Tag="yasb" Checked="OnBar" Content="YASB" />
            <RadioButton x:Name="BarZebar" Style="{StaticResource Segment}" GroupName="bar" Tag="zebar" Checked="OnBar" Content="Zebar" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="BarHint" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Button x:Name="RemoveZebar" Content="{ui:T settings.zebarRemove}" Click="OnRemoveZebar" HorizontalAlignment="Left" Margin="0,10,0,0" />
        <ui:JobView x:Name="BarJob" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="ExplorerBlurMica" Style="{StaticResource H2}" />
          <Border x:Name="BlurBadge" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{ui:T settings.explorerBlurText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14" />
        <CheckBox x:Name="BlurSwitch" Style="{StaticResource Switch}" Content="{ui:T settings.explorerBlurSwitch}" Click="OnExplorerBlur" />
        <TextBlock x:Name="BlurHint" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
        <ui:JobView x:Name="BlurJob" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="{ui:T settings.paths}" Style="{StaticResource H2}" Margin="0,0,0,14" />
        <TextBlock Text="{ui:T settings.filesPath}" Style="{StaticResource H3}" Margin="0,0,0,4" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{ui:T settings.choose}" Click="OnChooseFiles" Margin="8,0,0,0" />
          <TextBox x:Name="FilesPath" Style="{StaticResource MonoBox}" LostFocus="OnPathsChanged" />
        </DockPanel>
        <TextBlock Text="{ui:T settings.filesPathHint}" Style="{StaticResource Small}" Margin="0,4,0,0" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <TextBlock Text="{ui:T settings.folders}" Style="{StaticResource H2}" Margin="0,0,0,14" />
        <WrapPanel x:Name="Folders" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
