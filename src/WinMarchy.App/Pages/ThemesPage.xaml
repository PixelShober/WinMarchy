<UserControl x:Class="WinMarchy.App.Pages.ThemesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinMarchy.App.Ui">
  <StackPanel>
    <DockPanel Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="LoadPreviews" Click="OnLoadPreviews" Margin="0,0,8,0" />
        <Button x:Name="LoadAllWallpapers" Click="OnLoadAllWallpapers" Margin="0,0,8,0" />
        <Button Content="{ui:T themes.import}" Click="OnImport" />
      </StackPanel>
      <StackPanel MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Text="{ui:T themes.title}" Style="{StaticResource H1}" />
        <TextBlock Text="{ui:T themes.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
      </StackPanel>
    </DockPanel>

    <Border Style="{StaticResource Card}" Padding="0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="Hero" Height="300" ClipToBounds="True">
          <UniformGrid x:Name="HeroPalette" Rows="1" />
          <Image x:Name="HeroImage" Stretch="UniformToFill" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="22,20,22,20">
          <TextBlock x:Name="SelName" Style="{StaticResource H1}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Border x:Name="SelMode" />
            <Border x:Name="SelCurrent" Margin="6,0,0,0" />
          </StackPanel>
          <UniformGrid x:Name="SelPalette" Rows="1" Height="18" Margin="0,16,0,0" />
          <TextBlock Text="{ui:T themes.targets}" Style="{StaticResource H3}" Margin="0,18,0,8" />
          <WrapPanel x:Name="Targets" />
          <TextBlock x:Name="WallpaperInfo" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource SmallButton}" Content="{ui:T themes.addOwn}" Click="OnAddOwn" Margin="0,0,8,0" />
            <Button Style="{StaticResource SmallButton}" Content="{ui:T themes.openOwn}" Click="OnOpenOwn" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Style="{StaticResource Primary}" Content="{ui:T themes.apply}" Click="OnApply" />
            <CheckBox x:Name="WithWallpapers" Content="{ui:T themes.withWallpapers}" VerticalAlignment="Center" Margin="14,0,0,0" IsChecked="True" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <ui:JobView x:Name="Job" Margin="0,20,0,0" />

    <TextBlock Text="{ui:T themes.all}" Style="{StaticResource H2}" Margin="0,26,0,12" />
    <ItemsControl x:Name="Gallery">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
    <TextBlock x:Name="Credit" Style="{StaticResource Small}" Margin="0,14,0,0" />
  </StackPanel>
</UserControl>
