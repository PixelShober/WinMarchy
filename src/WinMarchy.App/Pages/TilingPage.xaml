<UserControl x:Class="WinMarchy.App.Pages.TilingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinMarchy.App.Ui">
  <StackPanel>
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,22">
      <TextBlock Text="{ui:T tiling.title}" Style="{StaticResource H1}" />
      <TextBlock Text="{ui:T tiling.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{ui:T tiling.defaultLayout}" Style="{StaticResource H2}" />
        <TextBlock Text="{ui:T tiling.defaultLayoutText}" Style="{StaticResource Muted}" Margin="0,4,0,16" />
        <UniformGrid x:Name="Layouts" Columns="4" />
        <Border Background="{DynamicResource Surface2}" Padding="14,10" Margin="0,4,0,0">
          <DockPanel>
            <ui:Icon Kind="info" Size="15" Foreground="{DynamicResource AccentFg}" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,2,10,0" />
            <TextBlock Text="{ui:T tiling.scrollingNote}" Style="{StaticResource Body}" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="{ui:T tiling.refresh}" Click="OnRefreshWorkspaces" VerticalAlignment="Top" />
          <TextBlock Text="{ui:T tiling.workspaces}" Style="{StaticResource H2}" />
        </DockPanel>
        <StackPanel x:Name="Workspaces" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <Grid Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <StackPanel x:Name="Look">
          <TextBlock Text="{ui:T tiling.look}" Style="{StaticResource H2}" Margin="0,0,0,14" />
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="14" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{ui:T tiling.innerGap}" Style="{StaticResource H3}" Margin="0,0,0,4" />
              <ComboBox x:Name="InnerGap" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{ui:T tiling.outerGap}" Style="{StaticResource H3}" Margin="0,0,0,4" />
              <ComboBox x:Name="OuterGap" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel x:Name="Desktop">
          <TextBlock Text="{ui:T tiling.desktop}" Style="{StaticResource H2}" Margin="0,0,0,14" />
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
      <Button Style="{StaticResource Primary}" Content="{ui:T tiling.apply}" Click="OnApply" />
      <TextBlock Text="{ui:T tiling.applyHint}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="14,0,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
