<UserControl x:Class="WinMarchy.App.Pages.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:WinMarchy.App.Ui">
  <StackPanel>
    <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,22">
      <TextBlock Text="{ui:T setup.title}" Style="{StaticResource H1}" />
      <TextBlock Text="{ui:T setup.subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{ui:T setup.programs}" Style="{StaticResource H2}" />
          <TextBlock Text="{ui:T setup.programsText}" Style="{StaticResource Muted}" Margin="0,4,0,16" />
          <StackPanel x:Name="ToolChoices" />
          <Border Height="1" Background="{DynamicResource Border}" Margin="0,4,0,16" />
          <TextBlock Text="{ui:T setup.extras}" Style="{StaticResource H3}" />
          <TextBlock Text="{ui:T setup.extrasText}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,14" />
          <StackPanel x:Name="ExtraChoices" />
          <Button x:Name="InstallExtras" Content="{ui:T setup.installExtras}" Click="OnInstallExtras" HorizontalAlignment="Left" Margin="0,0,0,14" />
          <TextBlock x:Name="Detected" Style="{StaticResource Small}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel x:Name="Options">
          <TextBlock Text="{ui:T setup.options}" Style="{StaticResource H2}" Margin="0,0,0,16" />
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
      <Button x:Name="StartButton" Style="{StaticResource Primary}" Click="OnStart">
        <StackPanel Orientation="Horizontal">
          <ui:Icon Kind="play" Size="12" VerticalAlignment="Center" />
          <TextBlock Text="{ui:T setup.start}" Margin="8,0,0,0" />
        </StackPanel>
      </Button>
      <TextBlock Text="{ui:T setup.startHint}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="14,0,0,0" />
    </StackPanel>

    <ui:JobView x:Name="Job" Margin="0,20,0,0" />
  </StackPanel>
</UserControl>
